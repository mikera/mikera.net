---
interface Props {
  title?: string
  description?: string
}

const { title = 'mikera.net', description = "Mike Anderson's personal page" } = Astro.props
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const ogImage = new URL('/mike-bw.jpg', Astro.site)
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="keywords" content="hacker, developer, open-source, economics, crypto, blockchain, data, AI, freedom" />
    <meta name="author" content="mikera" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content="mikera" />
    <meta property="og:description" content="Where code meets creativity. Explore my projects and hacks." />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="mikera.net" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="mikera featured image" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:type" content="website" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="mikera" />
    <meta name="twitter:description" content="Economics, crypto, AI and tech insights from mikera." />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/mikera-icon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Electrolize&family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&family=Noto+Serif:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />

    <title>{title}</title>
  </head>
  <body>
    <header>
      <div>
        <h1><a href="/">mikera</a></h1>
      </div>
      <nav>
        <div class="menubar">
          <h3><a href="/manifesto/">Manifesto</a></h3>
          <h3><a href="/projects/">Creations</a></h3>
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <div></div>
      <div>
        <p>Follow: <a href="https://x.com/mikera" target="_blank" rel="noopener noreferrer">@mikera</a></p>
        <p>GitHub: <a href="https://github.com/mikera" target="_blank" rel="noopener noreferrer">mikera</a></p>
        <p>LinkedIn: <a href="https://www.linkedin.com/in/mike-cvx/" target="_blank" rel="noopener noreferrer">Mike</a></p>
        <p>Discord: <a href="https://discord.com/invite/xfYGq4CT7v" target="_blank" rel="noopener noreferrer">Convex</a></p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @import '../styles/globals.css';
</style>
