---
import ManifestoLayout from '../../layouts/ManifestoLayout.astro'
import { getCollection, render } from 'astro:content'

const allTopics = await getCollection('manifesto')
const topics = allTopics.sort((a, b) => a.data.order - b.data.order)
const overview = topics.find(t => t.id === 'overview') ?? topics[0]
const { Content } = await render(overview)
---

<ManifestoLayout title="Manifesto - mikera.net" currentId="overview">
  <Content />
</ManifestoLayout>
