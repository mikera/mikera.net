---
import Base from '../../../layouts/Base.astro'
import ManifestoSidebar from '../../../components/ManifestoSidebar.astro'
import { getCollection, render } from 'astro:content'

export async function getStaticPaths() {
  const essays = await getCollection('essays')
  return essays.map(essay => ({
    params: { slug: essay.id },
    props: { essay }
  }))
}

const { essay } = Astro.props
const { Content } = await render(essay)
---

<Base title={`${essay.data.title} - mikera.net`}>
  <div style="display: flex; gap: 1rem;">
    <ManifestoSidebar currentId={essay.id} />
    <div style="flex: 1;" class="markdown-body">
      <Content />
    </div>
  </div>
</Base>
